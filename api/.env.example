NODE_ENV=development
PORT=4000

# Base de datos (SQLite en dev, Postgres URL en prod)
DATABASE_URL=file:./data/moix.db

# JWT
JWT_SECRET=cambiar-por-uno-generado-con-openssl-rand-hex-32
JWT_ISSUER=moix-legal-api
JWT_AUDIENCE=moix-legal-web
JWT_TTL_SECONDS=3600

# Chatbot upstream
CHATBOT_URL=http://localhost:8000

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_CHAT_MAX=30

# Integraciones (opcionales en Fase 1)
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
CAL_COM_API_KEY=
