{
  "info": {
    "name": "Moix Legal API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:4000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "health",
      "request": { "method": "GET", "url": "{{base}}/healthz" }
    },
    {
      "name": "listar abogados",
      "request": { "method": "GET", "url": "{{base}}/api/v1/lawyers" }
    },
    {
      "name": "perfil abogado",
      "request": { "method": "GET", "url": "{{base}}/api/v1/lawyers/cristian-moix" }
    },
    {
      "name": "crear lead",
      "request": {
        "method": "POST",
        "url": "{{base}}/api/v1/leads",
        "header": [{ "key": "content-type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"area\":\"penal\",\"urgency\":\"high\",\"summary\":\"Consulta urgente\",\"contact\":{\"name\":\"Juan\",\"email\":\"juan@example.com\"}}"
        }
      }
    },
    {
      "name": "login admin",
      "request": {
        "method": "POST",
        "url": "{{base}}/api/v1/auth/login",
        "header": [{ "key": "content-type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@moixlegal.com.ar\",\"password\":\"cambiar-en-primer-uso-1234\"}"
        }
      }
    },
    {
      "name": "chat",
      "request": {
        "method": "POST",
        "url": "{{base}}/api/v1/chat",
        "header": [{ "key": "content-type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"session_id\":\"demo\",\"question\":\"Me despidieron sin causa\"}"
        }
      }
    }
  ]
}
