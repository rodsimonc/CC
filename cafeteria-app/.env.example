# Copiá como .env y ajustá. En local casi todo por defecto.
PORT=3200

# Secreto JWT (en producción, obligatorio y aleatorio):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-insecure-secret-cambiar-en-produccion
ACCESS_TOKEN_TTL=2h

DATABASE_FILE=./data/cafeteria.db

# Carpeta donde multer guarda las imágenes que sube el admin (en la DB va solo la ruta).
UPLOAD_DIR=./public/uploads
# Tamaño máximo por imagen subida, en MB.
UPLOAD_MAX_MB=4

# Admin (dueño) inicial OPCIONAL. Dejalo comentado para crearlo desde /admin.html el primer uso.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Cargar mesas / menú / datos del local de ejemplo la primera vez
SEED_SAMPLE_DATA=true

TRUST_PROXY=false

# HTTPS local (npm run gen-cert primero)
TLS_ENABLED=false
TLS_KEY_FILE=./certs/key.pem
TLS_CERT_FILE=./certs/cert.pem

NODE_ENV=development
