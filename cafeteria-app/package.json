{
  "name": "cafeteria-app",
  "version": "1.0.0",
  "description": "Cafetería online: landing con carrusel, menú por franja horaria (desayuno/brunch/cena), reservas de mesa con aviso por WhatsApp y panel de administración. Node/Express + SQLite + JWT.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js",
    "gen-cert": "node scripts/gen-cert.mjs"
  },
  "dependencies": {
    "better-sqlite3": "11.8.1",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "selfsigned": "2.4.1"
  }
}
